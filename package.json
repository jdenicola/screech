{
  "name": "screech",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 web",
    "build": "vite build web",
    "server": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts test/*.test.mjs",
    "local": "node --env-file-if-exists=.env --import tsx scripts/local.mjs",
    "ngrok": "node --env-file-if-exists=.env scripts/ngrok.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/http-proxy": "^11.6.6",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.10",
    "fastify": "^5.12.8",
    "livekit-client": "^2.15.0",
    "livekit-server-sdk": "^2.13.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
