PRODUCT_NAME=Screech
AUDIO_BITRATE_BPS=32000
AUDIO_DTX_ENABLED=true
AUDIO_RED_ENABLED=true
VAD_THRESHOLD_DBFS=-40
CHANNEL_MAX_CLIENTS=32
CHANNEL_TTL_SECONDS=86400
SQLITE_PATH=data/screech.sqlite
REDIS_ENABLED=false
REDIS_ADDRESS=
REDIS_PASSWORD=
LIVEKIT_USE_EXTERNAL_IP=false
LIVEKIT_URL=http://localhost:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=local-development-secret-change-me-32

# Acceso remoto sin login por navegador/callback
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Relay externo opcional; recomendado detrás de NAT sin puertos entrantes
TURN_HOST=
TURN_PORT=443
TURN_PROTOCOL=tls
TURN_SHARED_SECRET=
TURN_USERNAME=
TURN_CREDENTIAL=
# Permite candidatos LAN además de la IP pública si hay clientes internos
LIVEKIT_ADVERTISE_INTERNAL_IP=false
